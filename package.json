{
  "name": "petrankings",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:enable-rls": "tsx scripts/enable-rls.ts",
    "cadastrar:url": "tsx --env-file=.env scripts/cadastrar-por-url.ts",
    "cadastrar-produtos": "tsx scripts/cadastrar-com-tunel.ts",
    "cadastrar-produtos:direto": "tsx --env-file=.env scripts/cadastrar-produtos.ts",
    "auditar:imagens": "tsx scripts/auditar-e-reparar-imagens.ts",
    "tunel": "ssh -L 5433:127.0.0.1:5432 -N petrankings-vps",
    "backup:puxar": "tsx scripts/puxar-backup.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.8",
    "lucide-react": "^1.16.0",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.26.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "cheerio": "^1.2.0",
    "playwright": "^1.63.0",
    "prisma": "^6.4.1",
    "sharp": "^0.34.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "sharp": true
  }
}
