:80 {
    # 1. Painel de Analytics (Umami)
    @analytics host analytics.petrankings.com.br
    handle @analytics {
        reverse_proxy umami:3000
    }

    # 2. Painel de Monitoramento 24/7 (Uptime Kuma)
    @status host status.petrankings.com.br
    handle @status {
        reverse_proxy uptime-kuma:3001
    }

    # 3. Arquivos Estáticos de Uploads (Imagens WebP e Fichas Técnicas HTML com Alta Performance)
    handle_path /uploads/* {
        root * /var/www/uploads
        file_server
    }

    # 4. Portal PetRankings (Next.js 15) - Default / Fallback
    handle {
        reverse_proxy app:3000
    }
}
