:80 {
    # 1. Painel de Analytics (Umami)
    @analytics host analytics.petrankings.com.br
    handle @analytics {
        reverse_proxy umami:3000
    }

    # 2. Arquivos Estáticos de Uploads (Imagens WebP e Fichas Técnicas HTML com Alta Performance)
    handle_path /uploads/* {
        root * /var/www/uploads
        @html path *.html
        header @html X-Robots-Tag "noindex, nofollow"
        file_server
    }

    # 3. Bloqueio Estrito de Borda para Área Administrativa e Autenticação (Acesso Estritamente Local)
    @blocked_admin {
        path /admin*
        path /api/auth*
    }
    handle @blocked_admin {
        respond "Not Found" 404
    }

    # 4. Portal PetRankings (Next.js 15) - Default / Fallback
    handle {
        reverse_proxy app:3000
    }
}
