# Configurações do Banco de Dados PostgreSQL (Pooler e Direct URL)
DATABASE_URL="postgresql://usuario:senha@host-pooler:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://usuario:senha@host-pooler:5432/postgres"

# Segredo de Autenticação JWT para o Painel Administrativo (/admin)
JWT_SECRET="insira_uma_chave_secreta_longa_e_aleatoria_aqui"

# URL Pública do Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense (Configurado pelo adsense-monetization-architect)
# Substitua pelo seu ID de Editor do AdSense (ex: ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"

# Google Search Console Verification (Token da Meta Tag HTML)
# Exemplo: NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="abc123xyz..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Google Analytics 4 (Measurement ID - ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Blocos de Anúncios AdSense (Slots)
NEXT_PUBLIC_ADSENSE_SLOT_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_FEED=""
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=""

# 🛡️ Proteção de Acesso Administrativo e Camuflagem (Opção 1 - Portão Secreto)
# Habilita a área administrativa em produção através do portão secreto
ALLOW_ADMIN_IN_PRODUCTION="false"

# Rota secreta não-convencional para desbloquear a entrada do painel (ex: /bastidores ou qualquer slug)
ADMIN_SECRET_GATE_PATH="/bastidores"

# Chave secreta de alta entropia necessária na query param (?key=...) para liberar o cookie de entrada
ADMIN_GATE_KEY="insira_uma_chave_secreta_longa_aqui"

# 📬 Envio de E-mails Transacionais com Resend (Código OTP de Acesso)
# Crie sua chave gratuita em https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="PetRankings <onboarding@resend.dev>"
