# Configurações do Banco de Dados SQLite (ou PostgreSQL em Produção)
DATABASE_URL="file:./dev.db"

# Segredo de Autenticação JWT para o Painel Administrativo (/admin)
JWT_SECRET="insira_uma_chave_secreta_longa_e_aleatoria_aqui"

# URL Pública do Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense (Configurado pelo adsense-monetization-architect)
# Substitua pelo seu ID de Editor do AdSense (ex: ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"

# Google Search Console Verification (Token da Meta Tag HTML)
# Exemplo: NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="abc123xyz..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Blocos de Anúncios AdSense (Slots)
NEXT_PUBLIC_ADSENSE_SLOT_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_FEED=""
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=""
